// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  displayName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchlistItems WatchlistItem[]
  predictions    Prediction[]
}

model Club {
  id              String   @id @default(uuid())
  name            String   @unique
  country         String
  league          String
  stadium         String?
  manager         String?
  logoUrl         String?
  estimatedBudget Float    @default(0)
  wageBudget      Float    @default(0)
  tacticalStyle   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  players          Player[]
  transfersFrom    Transfer[]       @relation("TransferFrom")
  transfersTo      Transfer[]       @relation("TransferTo")
  rumoursFrom      TransferRumour[] @relation("RumourCurrentClub")
  rumoursTo        TransferRumour[] @relation("RumourInterestedClub")
}

model Player {
  id             String   @id @default(uuid())
  name           String
  firstName      String?
  lastName       String?
  dateOfBirth    String?
  age            Int
  nationality    String?
  position       String
  preferredFoot  String?
  height         Int?
  shirtNumber    Int?
  marketValue    Float    @default(0)
  contractExpiry String?
  salary         Float?
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  currentClub   Club?   @relation(fields: [currentClubId], references: [id])
  currentClubId String?

  statistics      PlayerStatistics?
  transfers       Transfer[]
  rumours         TransferRumour[]
  watchlistItems  WatchlistItem[]
  predictions     Prediction[]
}

model PlayerStatistics {
  id                String @id @default(uuid())
  appearances       Int    @default(0)
  minutes           Int    @default(0)
  goals             Int    @default(0)
  assists           Int    @default(0)
  xG                Float  @default(0)
  xA                Float  @default(0)
  shots             Int    @default(0)
  shotsOnTarget     Int    @default(0)
  keyPasses         Int    @default(0)
  passes            Int    @default(0)
  passAccuracy      Float  @default(0)
  progressivePasses Int    @default(0)
  progressiveCarries Int   @default(0)
  dribbles          Int    @default(0)
  tackles           Int    @default(0)
  interceptions     Int    @default(0)
  clearances        Int    @default(0)
  aerialDuels       Int    @default(0)
  cleanSheets       Int    @default(0)

  player   Player @relation(fields: [playerId], references: [id])
  playerId String @unique
}

model Transfer {
  id           String   @id @default(uuid())
  season       String
  transferFee  Float    @default(0)
  transferType String   // Permanent, Loan, Free Transfer, etc.
  transferDate String
  createdAt    DateTime @default(now())

  player     Player @relation(fields: [playerId], references: [id])
  playerId   String
  fromClub   Club   @relation("TransferFrom", fields: [fromClubId], references: [id])
  fromClubId String
  toClub     Club   @relation("TransferTo", fields: [toClubId], references: [id])
  toClubId   String
}

model TransferRumour {
  id                  String   @id @default(uuid())
  source              String?
  sourceUrl           String?
  publishedAt         DateTime @default(now())
  lastUpdated         DateTime @updatedAt
  reliabilityScore    Int      @default(0)
  status              String   @default("Rumour")
  transferProbability Float    @default(0)
  createdAt           DateTime @default(now())

  player           Player @relation(fields: [playerId], references: [id])
  playerId         String
  currentClub      Club   @relation("RumourCurrentClub", fields: [currentClubId], references: [id])
  currentClubId    String
  interestedClub   Club   @relation("RumourInterestedClub", fields: [interestedClubId], references: [id])
  interestedClubId String
}

model WatchlistItem {
  id        String   @id @default(uuid())
  type      String   // "player" or "rumour"
  createdAt DateTime @default(now())

  user     User    @relation(fields: [userId], references: [id])
  userId   String
  player   Player? @relation(fields: [playerId], references: [id])
  playerId String?

  @@unique([userId, type, playerId])
}

model Prediction {
  id          String   @id @default(uuid())
  probability Float
  confidence  Float
  difficulty  String
  factors     Json     // Store the breakdown as JSON
  createdAt   DateTime @default(now())

  user     User?   @relation(fields: [userId], references: [id])
  userId   String?
  player   Player  @relation(fields: [playerId], references: [id])
  playerId String
  targetClubId String
}
